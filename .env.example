# Copy to .env.local (the engine reads it when it starts, from the folder it runs in: npm run dev /
# npm run server), or set these in Vercel: Project → Settings → Environment Variables.
# Variables already set in the shell win over the file.
# Nothing here is needed locally: with no settings the engine uses Ollama (glm-ocr + qwen3.5)
# and a local Postgres (PGlite, saved in data/).

# --- Database (Vercel: add Neon from the Marketplace; it sets DATABASE_URL for you) ---
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- Models in the cloud: any OpenAI-compatible API (OpenRouter, Groq, Z.ai, Together...) ---
# Shared by both roles unless OCR_* / TUTOR_* override them.
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=your-key                      # server-side only, never sent to the browser
# AI_THINK_OFF={"reasoning":{"enabled":false}}   # how this provider turns reasoning off
# AI_EXTRA_BODY={}                               # any extra JSON for every request

# Reading the child's line (OCR). Use a vision model your provider offers, by its id there.
# OCR_MODEL=provider/vision-model-id
# Or keep a different provider just for OCR:
# OCR_BASE_URL=...
# OCR_API_KEY=...

# Tutor (answers to questions).
# TUTOR_MODEL=provider/model-id

# How long one model call may take before the child is asked to try again (ms).
# Default 120000 (45000 on Vercel, whose function stops at 60 s). OCR_TIMEOUT_MS / TUTOR_TIMEOUT_MS per role.
# AI_TIMEOUT_MS=120000

# --- Local only ---
# OCR_PORT=3001
# HOST=127.0.0.1                                 # 0.0.0.0 opens the engine to the network: there is no login
# OLLAMA_URL=http://127.0.0.1:11434
